# ===========================================================================
# UBCab Backoffice (registration-bo) — Keycloak SSO auth
# ===========================================================================
# 2026-11-02: people log in to the BO with Microsoft SSO and the realm rejects the
# password grant on every client, so username/password + TOTP no longer works.
# Use a service account: a CONFIDENTIAL client with "Service accounts" enabled,
# created by the BO team with the roles the tools need (client_credentials grant).
UBCAB_BO_CLIENT_ID=
UBCAB_BO_CLIENT_SECRET=

# Alternative: refresh-token grant (e.g. an offline token from a one-time browser
# login). Sent with the client secret when one is set; when Keycloak rejects the
# refresh token, the server falls back to client_credentials.
UBCAB_BO_REFRESH_TOKEN=

# ===========================================================================
# Base URLs (defaults match production; override only if they change)
# ===========================================================================
UBCAB_BO_SSO_URL=https://sso.ubcabtech.com
UBCAB_BO_REALM=ubcab-bo
UBCAB_BO_API_URL=https://registration-bo-api.ubcabtech.com
# Sent as Origin/Referer to satisfy the BO allowed-origins check.
UBCAB_BO_ORIGIN=https://operator.ubcab.mn

# ===========================================================================
# Marketing backoffice API (marketing-bo-api.ubcabtech.com) + image upload
# Uses the UBCAB_BO_* client unless it gets its own:
# ===========================================================================
# UBCAB_MARKETING_CLIENT_ID=
# UBCAB_MARKETING_CLIENT_SECRET=
# UBCAB_MARKETING_REFRESH_TOKEN=
# UBCAB_MARKETING_API_URL=https://marketing-bo-api.ubcabtech.com

# ===========================================================================
# UBExpress OPERATOR API (operator-api.ubcabexpress.mn)
# Same Keycloak realm (ubcab-bo), its own client. Only needed for the
# ubcab_express_order_search / _return_search tools.
# ===========================================================================
UBCAB_EXPRESS_CLIENT_ID=
UBCAB_EXPRESS_CLIENT_SECRET=
# Optional overrides (defaults shown):
# UBCAB_EXPRESS_API_URL=https://operator-api.ubcabexpress.mn
# UBCAB_EXPRESS_ORIGIN=https://office.ubcabexpress.mn
# UBCAB_EXPRESS_REFRESH_TOKEN=

# ===========================================================================
# UBEats backoffice API (ubeats-bo-api.ubcabtech.com) — ubeats_* tools
# Uses the UBCAB_BO_* client (it then needs the UBEats roles and the
# office.ubeats.mn Web origin) unless it gets its own:
# ===========================================================================
# UBEATS_CLIENT_ID=
# UBEATS_CLIENT_SECRET=
# UBEATS_REFRESH_TOKEN=
# Optional overrides (defaults shown):
# UBEATS_API_URL=https://ubeats-bo-api.ubcabtech.com
# UBEATS_ORIGIN=https://office.ubeats.mn

# ===========================================================================
# Remote (Vercel) deployment only
# Secret bearer token clients must send to reach the /mcp endpoint.
# Generate one with:  openssl rand -hex 32
# REQUIRED in production — the endpoint fails closed without it.
# ===========================================================================
UBCAB_BO_MCP_AUTH_TOKEN=
